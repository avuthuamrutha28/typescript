//TS types
//1.Eplicit(mentioning the type)
let myName:string='Amrutha Avuthu';
console.log(myName)

//2.Implicit(TS itself finds the type based on given value)
let lastname='amrutha';
console.log(lastname);

//identifing errors in TS types

let brother='Heemanth reddy';
brother=26;
console.log(brother);
//it shows the error like number is not assignable to type string

let bbrother='Reddy;'
bbrother='hemanth';
