//TS special types
//TS always wont infer the type at that case there are some special types which disables the typechecking
//1.any
let a=false;
a='string';
Math.round(a);
console.log(a);

//it gives error like Argument of type 'boolean' is not assignable to parameter of type 'number'
//if we apply 'any' type to this then it donot show any error as it stops checking type check

let aa: any='true';
aa='string';
Math.round(aa);
console.log(aa);

//TS arrays
//syntax: const array_name=[item1, item2,....]
const family=['Maheesh', 'Srilakshmi', 'Heemanth', 'Amrutha'];
console.log(family);

const fam:string[]=[];
fam.push('Pandu', 'Viruth');
console.log(fam);

const names:string[]=[];
names.push(5);
console.log(names);//it gives the error like Argument of type 'number' is not assignable to parameter of type 'string' as we try to push number to a string.
//TS tuple: tuple is an array which has predefined length and type for each index

let tuple:[boolean, number, string];
tuple=[true, 5, 'ammu'];
tuple.push('something');
console.log(tuple);
//Readonly tuple: which cant be changed i.e can not add another element
const myReadonlyTuple:readonly[number, boolean, string]=[6, false, 'five'];
console.log(myReadonlyTuple);

const ourReadonlyTuple:readonly[number,string]=[2,'two'];
ourReadonlyTuple.push('anu');
console.log(ourReadonlyTuple);
//now if we try to insert another element in tuple while using readonly it gives error like Property 'push' does not exist on type 'readonly [number, string]'

//named tuple
const work:[x:number, y:string]=[55,'anjana'];
console.log(work);
//TS object types
const car:{type:string, model:string, year:number}={
    type:'toyoto',
    model:'corolla',
    year:2009
};
console.log(car)
//TS enums: two types
//1.string 2. numeric
enum directions{
    north,
    south,
    east,
    west
}
let currentdirection=directions.north
console.log(directions.north)//we will get value log 0

enum ddirections{
    north,
    south,
    east,
    west
}
let currentddirection=ddirections.north
console.log(ddirections) //we can observe here each directon increase by 1 by taking initial value 0
//TS alias:it gives the custome name insted of own name and mostly used for strings, objects, arrays

  type peopleName=string;
  type peopleAge=number;
  type peopleGender=string;
  type people={
    Name:peopleName;//here we gave custom name as Name for the PeopleName
    Age:peopleAge;
    Gender:peopleGender;
  }
const peopleName:peopleName='Teddy';
const peopleAge:peopleAge=5;
const peopleGender:peopleGender='Male'
const people:people={
    Name:peopleName,
    Age:peopleAge,
    Gender:peopleGender
};
console.log(people);

